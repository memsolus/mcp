{
  "name": "@memsolus/mcp",
  "version": "1.0.1",
  "description": "MCP Server for Memsolus — persistent memory tools for AI agents",
  "homepage": "https://github.com/memsolus/mcp#readme",
  "bugs": "https://github.com/memsolus/mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/memsolus/mcp"
  },
  "type": "module",
  "bin": {
    "memsolus-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@memsolus/sdk": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["memsolus", "mcp", "memory", "ai", "knowledge-graph"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
